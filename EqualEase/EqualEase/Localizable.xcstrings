    "Diagnostic control only: global bypass still routes audio through EqualEase. Per-app bypass is shown below and keeps that app tapped so it can still follow EqualEase’s selected output.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostic control only: global bypass still routes audio through EqualEase. Per-app bypass is shown below and keeps that app tapped so it can still follow EqualEase’s selected output."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun diagnostisk kontrol: global bypass sender stadig lyd gennem EqualEase. Bypass pr. app vises nedenfor og holder appen tappet, så den stadig kan følge EqualEases valgte output."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Diagnose-Steuerung: Der globale Bypass routet Audio weiterhin durch EqualEase. Der App-Bypass wird unten angezeigt und bindet diese App weiter als Tap ein, damit sie weiter der ausgewählten Ausgabe von EqualEase folgen kann."
          }
        }
      }
    },
