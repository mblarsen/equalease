    "Paired access protects remote control on your trusted local network. Traffic stays local but is not internet-grade encrypted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired access protects remote control on your trusted local network. Traffic stays local but is not internet-grade encrypted."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Parret adgang beskytter fjernbetjening på dit betroede lokale netværk. Trafikken forbliver lokal, men er ikke krypteret på internetniveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelter Zugriff schützt die Fernsteuerung in deinem vertrauenswürdigen lokalen Netzwerk. Der Datenverkehr bleibt lokal, ist aber nicht auf Internetniveau verschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso enlazado protege el control remoto en tu red local de confianza. El tráfico se queda en la red local, pero no tiene cifrado de nivel internet."
          }
        }
      },
      "comment": "Phone web remote footer explaining same-LAN pairing security."
    },
    "Paired as": {
      "extractionState": "manual",
