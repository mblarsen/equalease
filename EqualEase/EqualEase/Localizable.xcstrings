    },
    "Convenience control for your Mac’s output volume. Use this first for everyday loudness.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convenience control for your Mac’s output volume. Use this first for everyday loudness."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekvem kontrol af din Macs udgangslydstyrke. Brug den først til daglig lydstyrke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bequeme Steuerung der Ausgabelautstärke deines Mac. Verwende sie zuerst für die alltägliche Lautstärke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control práctico del volumen de salida del Mac. Úsalo primero para la sonoridad diaria."
          }
        }
      },
      "comment": "Help text below the output Volume slider."
    },
    "Changes EqualEase’s processing level while Active is on. Use Volume first; lower Preamp if boosted presets distort.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes EqualEase’s processing level while Active is on. Use Volume first; lower Preamp if boosted presets distort."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændrer EqualEases behandlingsniveau, mens Aktiv er slået til. Brug Lydstyrke først; sænk Preamp, hvis forstærkede forudindstillinger forvrænger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert EqualEases Verarbeitungspegel, während „Aktiv“ eingeschaltet ist. Verwende zuerst „Lautstärke“; senke „Preamp“, wenn verstärkte Presets verzerren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el nivel de procesamiento de EqualEase mientras Activo está encendido. Usa primero Volumen; baja Preamp si los preajustes reforzados distorsionan."
          }
        }
      },
      "comment": "Help text below the Preamp slider."
    },
    "Convenience control for your Mac’s current microphone input level. It stays editable even while EqualEase is off.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convenience control for your Mac’s current microphone input level. It stays editable even while EqualEase is off."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekvem kontrol af din Macs aktuelle mikrofonindgangsniveau. Den kan stadig redigeres, selv når EqualEase er slået fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bequeme Steuerung des aktuellen Mikrofoneingangspegels deines Mac. Sie bleibt auch bearbeitbar, wenn EqualEase ausgeschaltet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control práctico del nivel de entrada del micrófono actual del Mac. Sigue editable incluso cuando EqualEase está apagado."
          }
        }
      },
      "comment": "Help text below the input volume slider when EqualEase can set the current microphone input level."
    },
    "EqualEase can read this input’s volume, but this device does not expose volume control.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase can read this input’s volume, but this device does not expose volume control."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase kan læse denne indgangs lydstyrke, men enheden tilbyder ikke lydstyrkekontrol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase kann die Lautstärke dieses Eingangs lesen, aber dieses Gerät stellt keine Lautstärkesteuerung bereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase puede leer el volumen de esta entrada, pero este dispositivo no expone control de volumen."
          }
        }
      },
      "comment": "Help text below the input volume slider when EqualEase can read but not set the current microphone input level."
    },
    "This input does not expose volume control. Use System Settings or the device’s own controls if available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This input does not expose volume control. Use System Settings or the device’s own controls if available."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne indgang tilbyder ikke lydstyrkekontrol. Brug Systemindstillinger eller enhedens egne kontroller, hvis de findes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eingang stellt keine Lautstärkesteuerung bereit. Verwende die Systemeinstellungen oder, falls verfügbar, die Bedienelemente des Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta entrada no expone control de volumen. Usa Ajustes del Sistema o los controles del propio dispositivo si están disponibles."
          }
        }
      },
      "comment": "Help text below the input volume slider when the current microphone input does not expose volume control."
    },
    "Built-ins are read-only templates. EQ and gain changes are live until you save them as a new preset.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-ins are read-only templates. EQ and gain changes are live until you save them as a new preset."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indbyggede forudindstillinger er skrivebeskyttede skabeloner. EQ- og gain-ændringer er live, indtil du gemmer dem som en ny forudindstilling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrierte Presets sind schreibgeschützte Vorlagen. EQ- und Gain-Änderungen sind live, bis du sie als neues Preset speicherst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los preajustes integrados son plantillas de solo lectura. Los cambios de EQ y ganancia son en vivo hasta que los guardes como un preajuste nuevo."
          }
        }
      },
      "comment": "Description under Presets settings when a built-in preset is selected."
    },
    "Changes are live for listening. Save the custom preset when you want to keep them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are live for listening. Save the custom preset when you want to keep them."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringerne er live, mens du lytter. Gem den brugerdefinerede forudindstilling, når du vil beholde dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen sind beim Anhören live. Speichere das eigene Preset, wenn du sie behalten möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican en vivo al escuchar. Guarda el preajuste personalizado cuando quieras conservarlos."
          }
        }
      },
      "comment": "Description under Presets settings when a custom preset is selected."
    },
    "Choose a preset to edit EQ values.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a preset to edit EQ values."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en forudindstilling for at redigere EQ-værdier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Preset aus, um EQ-Werte zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un preajuste para editar valores de EQ."
          }
        }
      },
      "comment": "Description under Presets settings when no preset is selected."
    },
