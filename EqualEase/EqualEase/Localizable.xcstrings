    },
    "macOS cannot register this build as a login item. Copy EqualEase to Applications or use a packaged build, then reopen Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS cannot register this build as a login item. Copy EqualEase to Applications or use a packaged build, then reopen Settings."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kan ikke registrere dette build som et loginemne. Kopiér EqualEase til Programmer, eller brug et pakket build, og åbn derefter Indstillinger igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kann diesen Build nicht als Anmeldeobjekt registrieren. Kopiere EqualEase in „Programme“ oder verwende einen paketierten Build und öffne dann die Einstellungen erneut."
          }
        }
      }
    }
  },
  "version": "1.0"
