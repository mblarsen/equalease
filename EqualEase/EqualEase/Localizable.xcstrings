    "%@ is at %lld%%, below your %lld%% low-volume threshold.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is at %2$lld%%, below your %3$lld%% low-volume threshold."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er på %2$lld%%, under din grænseværdi på %3$lld%% for lav lydstyrke."
