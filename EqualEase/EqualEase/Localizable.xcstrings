    "If development audio gets stuck silent, stop routing and clean up EqualEase-owned Core Audio taps and aggregate devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If development audio gets stuck silent, stop routing and clean up EqualEase-owned Core Audio taps and aggregate devices."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis udviklingslyd sætter sig fast i stilhed, så stop routing og ryd op i Core Audio-taps og aggregerede enheder, som EqualEase ejer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Entwicklungs-Audio stumm hängen bleibt, stoppe das Routing und bereinige die Core-Audio-Taps und Aggregatgeräte, die EqualEase gehören."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el audio de desarrollo se queda en silencio, detén la ruta de audio y limpia los taps de Core Audio y dispositivos agregados propiedad de EqualEase."
          }
        }
      }
    },
    "Ignores app and website preset rules and keeps the current preset while you switch focus.": {
