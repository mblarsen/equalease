    "Choose System Default to follow your macOS language order. Language changes apply after you quit and reopen EqualEase.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose System Default to follow your macOS language order. Language changes apply after you quit and reopen EqualEase."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg Systemstandard for at følge din macOS-sprogrækkefølge. Sprogændringer træder i kraft, når du afslutter og åbner EqualEase igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Systemstandard, um deiner macOS-Sprachreihenfolge zu folgen. Sprachänderungen gelten, nachdem du EqualEase beendet und erneut geöffnet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Predeterminado del sistema para seguir el orden de idiomas de macOS. Los cambios de idioma se aplican después de cerrar y volver a abrir EqualEase."
          }
        }
      },
