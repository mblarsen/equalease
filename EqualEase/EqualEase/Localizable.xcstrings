          }
        }
      },
      "comment": "Decibel gain value. Keep the dB unit with the numeric value."
    },
    "%@ Copy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Copy"
          }
        }
      },
      "comment": "Default name for a duplicated custom preset. Interpolation is the original preset name."
    },
    "%@ decibels": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ decibels"
          }
        }
      },
      "comment": "VoiceOver value for decibel gain. Interpolation is a formatted gain value."
    },
    "%@ for %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ for %2$@"
          }
        }
      },
      "comment": "Compact preset status. First interpolation is a preset name; second is an app name or website display name/host."
    },
    "%@ hertz band": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hertz band"
          }
        }
      },
      "comment": "VoiceOver label for an EQ frequency band. Interpolation is the band frequency label."
    },
    "%@ is at %lld%%, below your %lld%% low-volume threshold.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is at %2$lld%%, below your %3$lld%% low-volume threshold."
          }
        }
      },
      "comment": "Local notification body. Interpolations are input device name, current input volume percentage, and configured low-volume threshold percentage."
    },
