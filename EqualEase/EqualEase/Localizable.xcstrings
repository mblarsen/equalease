    "EqualEase Remote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase Remote"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase-fjernbetjening"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase-Fernsteuerung"
          }
        }
      },
      "comment": "Browser title for the paired phone web remote."
    },
    "EqualEase can launch quietly in the menu bar. Audio routing stays off until you turn it on, unless you explicitly enable automatic routing here. Audio processing happens locally on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase can launch quietly in the menu bar. Audio routing stays off until you turn it on, unless you explicitly enable automatic routing here. Audio processing happens locally on this Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase kan starte diskret i menulinjen. Lydrouting forbliver slået fra, indtil du slår den til, medmindre du udtrykkeligt aktiverer automatisk routing her. Lydbehandling sker lokalt på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase kann unauffällig in der Menüleiste starten. Audio-Routing bleibt aus, bis du es einschaltest, es sei denn, du aktivierst hier ausdrücklich automatisches Routing. Die Audioverarbeitung erfolgt lokal auf diesem Mac."
          }
        }
      }
    },
    "EqualEase can switch to this preset whenever %@ becomes the active app, then return to your selected default preset when you switch away.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase can switch to this preset whenever %@ becomes the active app, then return to your selected default preset when you switch away."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase kan skifte til denne forudindstilling, når %@ bliver den aktive app, og derefter vende tilbage til din valgte standardforudindstilling, når du skifter væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase kann zu diesem Preset wechseln, sobald %@ die aktive App wird, und danach zu deinem ausgewählten Standardpreset zurückkehren, wenn du wegwechselst."
          }
        }
      },
      "comment": "Smart-switching prompt body for app rules. Interpolation is the active app name."
    },
    "EqualEase can switch to this preset whenever %@ is the active website in a supported browser, then fall back to your app or default preset when you switch away.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase can switch to this preset whenever %@ is the active website in a supported browser, then fall back to your app or default preset when you switch away."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase kan skifte til denne forudindstilling, når %@ er det aktive websted i en understøttet browser, og derefter falde tilbage til din app- eller standardforudindstilling, når du skifter væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase kann zu diesem Preset wechseln, sobald %@ die aktive Website in einem unterstützten Browser ist, und danach auf dein App- oder Standardpreset zurückfallen, wenn du wegwechselst."
          }
        }
      },
      "comment": "Smart-switching prompt body for website rules. Interpolation is a website display name or host."
    },
    "EqualEase couldn't read %@'s current page. Check macOS Automation permission for EqualEase, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase couldn't read %@'s current page. Check macOS Automation permission for EqualEase, then try again."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase kunne ikke læse den aktuelle side i %@. Kontrollér macOS-automatiseringstilladelsen for EqualEase, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase konnte die aktuelle Seite von %@ nicht lesen. Prüfe die macOS-Automatisierungsberechtigung für EqualEase und versuche es erneut."
          }
        }
      }
    },
    "EqualEase processes audio locally on this Mac. It does not record, save, upload, sell, or share audio.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase processes audio locally on this Mac. It does not record, save, upload, sell, or share audio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase behandler lyd lokalt på denne Mac. Appen optager, gemmer, uploader, sælger eller deler ikke lyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase verarbeitet Audio lokal auf diesem Mac. Es nimmt Audio nicht auf, speichert es nicht, lädt es nicht hoch, verkauft es nicht und teilt es nicht."
          }
        }
      }
    },
    "EqualEase shows input state for convenience only. Input-device selection, microphone routing, and microphone EQ are intentionally out of scope.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase shows input state for convenience only. Input-device selection, microphone routing, and microphone EQ are intentionally out of scope."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase viser inputtilstand kun som en hjælp. Valg af inputenhed, mikrofonrouting og mikrofon-EQ er bevidst uden for scope."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase zeigt den Eingangsstatus nur der Übersicht halber an. Eingabegeräte-Auswahl, Mikrofon-Routing und Mikrofon-EQ sind bewusst nicht Teil des Funktionsumfangs."
          }
        }
      }
    },
