            "state": "translated",
            "value": "Konvolutten skal være et JSON-objekt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Umschlag muss ein JSON-Objekt sein."
          }
        }
      },
      "comment": "Remote-control protocol error for malformed WebSocket JSON."
    },
    "EqualEase": {
      "extractionState": "manual",
      "localizations": {
