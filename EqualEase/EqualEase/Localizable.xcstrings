    "macOS asks for capture permission when routing starts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for capture permission when routing starts"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS beder om optagelsestilladelse, når routing starter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt beim Starten des Routings nach Erfassungsberechtigung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide permiso de captura cuando se inicia la ruta de audio"
          }
        }
      }
    },
    "macOS cannot register this build as a login item. Copy EqualEase to Applications or use a packaged build, then reopen Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS cannot register this build as a login item. Copy EqualEase to Applications or use a packaged build, then reopen Settings."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kan ikke registrere dette build som et loginemne. Kopiér EqualEase til Programmer, eller brug et pakket build, og åbn derefter Indstillinger igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kann diesen Build nicht als Anmeldeobjekt registrieren. Kopiere EqualEase in „Programme“ oder verwende einen paketierten Build und öffne dann die Einstellungen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no puede registrar esta compilación como ítem de inicio de sesión. Copia EqualEase a Aplicaciones o usa una compilación empaquetada y vuelve a abrir Ajustes."
          }
        }
      }
    },
