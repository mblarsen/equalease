    "%@ is at %lld%%, below your %lld%% low-volume threshold.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is at %2$lld%%, below your %3$lld%% low-volume threshold."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ er på %2$lld%%, under din grænseværdi på %3$lld%% for lav lydstyrke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ liegt bei %2$lld%% und damit unter deinem Schwellenwert für niedrige Lautstärke von %3$lld%%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está al %2$lld%%, por debajo de tu umbral de volumen bajo del %3$lld%%."
          }
        }
      },
      "comment": "Local notification body. Interpolations are input device name, current input volume percentage, and configured low-volume threshold percentage."
