    "Per-app mute: tapped but silenced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-app mute: tapped but silenced"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyd fra pr. app: tappet, men med lyden slået fra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App stumm: als Tap eingebunden, aber stummgeschaltet"
          }
        }
      }
    },
    "Per-app off: verbatim pass-through, no volume, no EQ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-app off: verbatim pass-through, no volume, no EQ"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra pr. app: uændret pass-through, ingen lydstyrke, ingen EQ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App aus: unverändert durchgeleitet, keine Lautstärke, kein EQ"
          }
        }
      }
    },
    "Per-app volume is attenuation only: 100% is normal volume. Use Preamp for global boost.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-app volume is attenuation only: 100% is normal volume. Use Preamp for global boost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydstyrke pr. app dæmper kun: 100% er normal lydstyrke. Brug Preamp til global boost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke pro App ist nur Absenkung: 100% ist normale Lautstärke. Verwende Preamp für globale Verstärkung."
          }
        }
      }
    },
    "Per-app volume uses one tap per audio-emitting app plus a fallback tap for everything else. Off apps remain tapped but pass through verbatim; muted apps are tapped but silenced.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-app volume uses one tap per audio-emitting app plus a fallback tap for everything else. Off apps remain tapped but pass through verbatim; muted apps are tapped but silenced."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydstyrke pr. app bruger ét tap pr. lydafspillende app plus et fallback-tap til alt andet. Apps i Fra-tilstand forbliver tappet, men sendes uændret igennem; apps med lyden slået fra er tappet, men med lyden slået fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke pro App nutzt einen Tap je App mit Audiowiedergabe plus einen Fallback-Tap für alles andere. Ausgeschaltete Apps bleiben als Tap eingebunden, werden aber unverändert durchgeleitet; stummgeschaltete Apps sind als Tap eingebunden, aber stumm."
          }
        }
      }
    },
