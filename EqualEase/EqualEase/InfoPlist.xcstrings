{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase"
          }
        }
      },
      "comment": "Bundle name"
    },
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase reads the active website in supported browsers only when applying or creating website preset rules."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase læser kun det aktive websted i understøttede browsere, når appen anvender eller opretter regler for webstedsforudindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase liest die aktive Website in unterstützten Browsern nur, wenn Website-Preset-Regeln angewendet oder erstellt werden."
          }
        }
      },
      "comment": "Privacy - AppleEvents Sending Usage Description"
    },
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "comment": "Privacy - Audio Capture Usage Description. Explain that EqualEase captures system output audio locally to apply EQ before playback.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase needs to capture system audio so it can apply equalizer processing before playing audio to your selected output device."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase skal optage systemlyd, så appen kan anvende equalizerbehandling, før lyden afspilles på din valgte outputenhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase muss Systemaudio erfassen, um Equalizer-Verarbeitung anzuwenden, bevor Audio auf deinem ausgewählten Ausgabegerät wiedergegeben wird."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase uses the local network to let your phone control Volume, Preamp, and presets while staying on your trusted Wi-Fi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase bruger det lokale netværk til at lade din telefon styre Lydstyrke, Preamp og forudindstillinger, mens den bliver på dit betroede Wi‑Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EqualEase nutzt das lokale Netzwerk, damit dein Telefon Lautstärke, Preamp und Presets steuern kann, während alles in deinem vertrauenswürdigen WLAN bleibt."
          }
        }
      },
      "comment": "Privacy - Local Network Usage Description"
    }
  },
  "version": "1.0"
}
